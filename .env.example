# Copy this file to .env and fill in what your machine needs. .env is
# gitignored - real values (and any machine-specific paths) never get
# committed. Everything here is optional except RTKDASH_GNSSREFL_PYTHON,
# which has no portable default at all - see config.py for the full
# reasoning behind each default.
#
# Real OS/conda environment variables always take priority over .env if
# both happen to be set for the same name.

# --- rclone / Google Drive sync --------------------------------------------
# Path to the rclone config holding the "gdrive" remote. Leave unset to
# use rclone's own default config location.
# RTKDASH_RCLONE_CONF=

# Days of history to sync/display by default. Default: 3
# RTKDASH_HISTORY_DAYS=3

# Days of slack past a station's upload cycle a routine sync pulls, and
# the timeout budgets for a routine vs. full (force-full-reprocess) sync.
# Defaults: 5, 300, 3600
# RTKDASH_SYNC_WINDOW_DAYS=5
# RTKDASH_SYNC_TIMEOUT_SECONDS=300
# RTKDASH_SYNC_FULL_TIMEOUT_SECONDS=3600

# IANA zone every chart/timestamp is rendered in. Default: Pacific/Auckland
# RTKDASH_DISPLAY_TZ=Pacific/Auckland

# --- GNSS-IR (gnssrefl) pipeline --------------------------------------------
# gnssrefl's own working directories (SNR files, orbit/nav cache, daily
# results, VWC output) - can grow to several GB, meant to live outside
# this repo. Default: a refl_data/ sibling directory next to this repo.
# REFL_CODE=
# ORBITS=
# EXE=

# python.exe of the "gnssrefl" conda env (see environment-gnssrefl.yml).
# REQUIRED - no portable default exists. Get the real path with:
#   conda run -n gnssrefl python -c "import sys; print(sys.executable)"
RTKDASH_GNSSREFL_PYTHON=

# How many days back a day gets reprocessed even if it already has a
# result (multi-GNSS orbits lag real time by ~2 days). Default: 5
# RTKDASH_GNSSREFL_REPROCESS_WINDOW_DAYS=5

# Minimum same-track repeat points before gnssrefl trusts a soil-moisture
# track (gnssrefl's own default is 30, tuned for a year+ of history).
# Default: 5
# RTKDASH_GNSSREFL_VWC_MIN_TRACK_PTS=5

# Keep each processed day's RINEX obs/nav in RTKDASH_RINEX_DIR/<hostname>/
# instead of deleting it after rinex2snr. Default: off
# RTKDASH_GNSSREFL_KEEP_RINEX=1
# Default: a rinex/ folder inside REFL_CODE
# RTKDASH_RINEX_DIR=
# Dashboard warns once that folder (all stations) exceeds this many GB.
# Default: 20
# RTKDASH_RINEX_WARN_GB=20
